@page
@model CreateCustomerModel

<div class="d-flex justify-content-center mt-5">
    <h1>Create Customer</h1>
</div>
<div class="d-flex justify-content-center align-items-center mt-5">
    <form method="post">
        <div class="text-center">
            <label>Name: </label>
            <input autocomplete="off" class="rounded-pill" type="text" , asp-for="Name" />
        </div>
        <div class="spacer"></div>
        <div class="text-center">
            <label>Email: </label>
            <input autocomplete="off" class="rounded-pill" type="text" , asp-for="Email" />
        </div>


        <div class="spacer"></div>
        <div class="text-center">
            <label>Password: </label>
            <input class="rounded-pill" type="password" , asp-for="Password" />
        </div>
        @{
            if (!@Model.ValidModelEntry)
            {
                <div class="d-flex justify-content-center mt-5">
                    <p class="invalid_input">Invalid input to the required fields</p>
                </div>
            }
        }
        @{
            if (!string.IsNullOrEmpty(@Model.InvalidRegistration))
            {
                <div class="d-flex justify-content-center mt-5">
                    <p class="invalid_input">@Model.InvalidRegistration</p>
                </div>
            }
        }

        <div class="d-flex justify-content-center mt-5">
            <button type="submit" class="icon-btn send material-icons">send</button>
        </div>
    </form>
</div>
