@page
@model CheckoutModel

<div class="d-flex justify-content-center mt-5">
    <h1>Checkout summary</h1>
</div>
@{
    double total = 0.0;
}
<form method="post" id="autoForm" asp-page-handler="Basket">
    <input type="hidden" name="Basket" id="Basket" />
</form>


<script>

    window.checkoutPageVisitId = '@Model.CheckoutPageVisitId';

    window.addEventListener("pageshow", function (event) {
        if (event.persisted) return;


        const basketRaw = localStorage.getItem("basket");

        const basket = JSON.parse(basketRaw);


        const submitKey = "submitted:" + window.checkoutPageVisitId;


        if (sessionStorage.getItem(submitKey) == "true") { return; }

        document.getElementById("Basket").value = JSON.stringify(basket);


        document.getElementById("autoForm").submit();
        sessionStorage.setItem("submitted:" + window.basketPageVisitId, "true");

    });
</script>

<div class="d-flex justify-content-center mt-5">
    <table class="records" class="text-center">
        <thead>
            <tr>
                <th>Name</th>
                <th>Quantity</th>
                <th>Price</th>


            </tr>
        </thead>

        <tbody>
            @foreach (var product in Model.Products)
            {
                <tr>
                    <td>@product.Name</td>
                    <td>@product.Quantity</td>
                    <td>£@((product.Price * product.Quantity).ToString("0.00"))</td>

                </tr>
                total += product.Price * product.Quantity;
            }
        </tbody>
    </table>
</div>
<div class="d-flex justify-content-center mt-5">
    <h2>Total cost: £@total.ToString("0.00")</h2>
</div>
<div class="d-flex justify-content-center mt-5">
    <form asp-page-handler="Checkout">
        <button onclick="clearBasket()" type="submit"> Place Order <i class="icon send material-icons">send</i></button>
    </form>
</div>