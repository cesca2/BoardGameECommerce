@page
@model LoginModel

<div class="d-flex justify-content-center mt-5">

    <h1>Customer Login</h1>


</div>

<div class="d-flex justify-content-center align-items-center mt-5">
    <form method="post">
        <div class="text-center">
            <label>Email:</label>
            <input autocomplete="off" class="rounded-pill" type="text" , asp-for="Email" />
        </div>
        <div class="spacer"></div>
        <div class="text-center">
            <label>Password: </label>
            <input class="rounded-pill" type="password" , asp-for="Password" />
        </div>


        @{
            if (!@Model.ValidModelEntry)
            {
                <div class="d-flex justify-content-center mt-5">
                    <p class="invalid_input">Login failed, please try again</p>
                </div>
            }
        }

        @{
            if (!string.IsNullOrEmpty(@Model.InvalidLogin))
            {
                <div class="d-flex justify-content-center mt-5">
                    <p class="invalid_input">@Model.InvalidLogin</p>
                </div>
            }
        }

        <div class="d-flex justify-content-center mt-5">
            <button type="submit" class="icon-btn send material-icons">send</button>
        </div>
    </form>
</div>
<div class="d-flex justify-content-center mt-5 text-center">
    <a style="font-size: 20px;" asp-page="./CreateCustomer" , type="submit" , class="link_icon confirm" ,
       id="new_record"><i class="material-icons icon">person_add</i> New customer? Register here </a>

</div class="text-center">
